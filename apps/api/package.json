{
  "name": "@cupidilla/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch --env-file ../../.env",
    "build": "nest build",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "start:e2e": "node scripts/reset-db.ts && node scripts/migrate.ts && node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration --project integration-serial",
    "db:generate": "drizzle-kit generate",
    "db:studio": "node --env-file=../../.env ../../node_modules/drizzle-kit/bin.cjs studio",
    "db:migrate": "node --env-file-if-exists=../../.env scripts/migrate.ts"
  },
  "dependencies": {
    "@cupidilla/contracts": "*",
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/throttler": "6.7.1",
    "argon2": "0.45.2",
    "drizzle-orm": "0.45.4",
    "nodemailer": "10.3.1",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cupidilla/fake-oauth-provider": "*",
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
