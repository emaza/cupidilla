# PostgreSQL (docker compose)
POSTGRES_USER=cupidilla
POSTGRES_PASSWORD=cupidilla_dev
POSTGRES_DB=cupidilla
POSTGRES_PORT=5432

# API (127.0.0.1 y no localhost: Node puede resolver localhost a ::1 y Docker solo escucha en IPv4)
DATABASE_URL=postgres://cupidilla:cupidilla_dev@127.0.0.1:5432/cupidilla
# Límites de PostgreSQL en ms (§7.2 del diseño técnico); se muestran sus valores por defecto.
# Los dos primeros, 4000 como mucho (query_timeout = DB_STATEMENT_TIMEOUT_MS + 500 < 5 s de la web)
# DB_CONNECTION_TIMEOUT_MS=3000
# DB_STATEMENT_TIMEOUT_MS=4000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
TEST_DATABASE_URL=postgres://cupidilla:cupidilla_dev@127.0.0.1:5432/cupidilla_test
E2E_DATABASE_URL=postgres://cupidilla:cupidilla_dev@127.0.0.1:5432/cupidilla_e2e
API_HOST=127.0.0.1
API_PORT=3001
# OBLIGATORIO: vacía a propósito. La API y la web no arrancan hasta que pongas una clave
# aleatoria propia (32 caracteres o más). Generar con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_KEY=
SESSION_TTL_DAYS=30
# Edad mínima para usar la app en esta instalación: entero de 18 a 25 (por defecto, 18).
# Cambiarla exige reiniciar la API; la web la lee de la API (caché de 60 s).
# MIN_AGE=18
RATE_LIMIT_FACTOR=1
LOG_FORMAT=pretty

# Inicio de sesión con terceros (API). Un proveedor solo se activa con su pareja completa.
# Origen público de la web, sin barra final: la redirect URI es <base>/auth/<proveedor>/callback
OAUTH_REDIRECT_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# OAUTH_HTTP_TIMEOUT_MS=3000
# Solo pruebas (nunca en producción): apunta los dos proveedores al proveedor falso local
# OAUTH_FAKE_PROVIDER_URL=http://127.0.0.1:4400

# Web (SvelteKit). API_URL tiene que ser https: salvo en loopback (127.0.0.1, localhost, ::1)
API_URL=http://127.0.0.1:3001
# Solo en una red privada de contenedores: permite API_URL con http: fuera de loopback
# API_URL_ALLOW_HTTP=false
